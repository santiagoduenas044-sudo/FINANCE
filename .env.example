# Copy to `.env` and fill in. NEVER commit the real values.
# All variables are OPTIONAL — every one has a safe local default.

# --- Discord output (Phase 5.5 / Phase 15) ---------------------------------
# GHOST authority guarantees: only APPROVED decisions ever reach Discord.
# Rejected signals (NO_TRADE) NEVER trigger a Discord alert.
#
# To turn Discord ON: (1) paste your webhook here, (2) set BOT_DISCORD_ENABLED
# to true, (3) restart the service. That's it — no YAML edit required.
#
DISCORD_WEBHOOK_URL=
BOT_DISCORD_ENABLED=false
# How much reaches the channel. corto (default): each trade's entry and exit
# (every set up), the day's close, verse/fact and errors. todo: also the
# heads-ups, progress, TP1/stop moves, ORBIT's box and BE+2, start/stop.
BOT_DISCORD=corto

# --- Discord commands: !status, !trades, !why, !help ----------------------
# The webhook above can only SEND. To answer commands the bot needs a bot
# token (Developer Portal -> your app -> Bot -> Reset Token). Also switch on
# "Message Content Intent" on that same Bot page, or commands arrive empty.
# Every command is READ-ONLY: none starts, stops or trades.
DISCORD_BOT_TOKEN=
# Optional: only answer in this channel (right-click channel -> Copy ID,
# with Developer Mode on). Empty = answer in any channel the bot can see.
DISCORD_BOT_CHANNEL_ID=

# Databento API key (db-...), only for scripts/fetch_databento.py backtest data.
DATABENTO_API_KEY=

# --- Runtime / server (Phase 13) -------------------------------------------
# How the process is served & secured.
#   local  = bind loopback only (127.0.0.1); safe default, no auth needed.
#   remote = bind BOT_HOST (default 0.0.0.0) for a VPS; REQUIRES an auth token.
BOT_MODE=local

# Host/port to bind. Defaults: 127.0.0.1 in local mode, 0.0.0.0 in remote mode.
BOT_HOST=
BOT_PORT=8000

# Which instruments to run (comma-separated).
BOT_SYMBOLS=ES,NQ

# Trading strategy: "zones" (default — first retrace into a 5m zone, confirmed
# on 1m, with heads-up / cancel messages) or "legacy" (old 5m setups).
BOT_STRATEGY=zones

# Seconds between poll/cycle ticks.
BOT_CYCLE_SECONDS=5

# Start the trading pipeline automatically on boot (RUNNING/ONLINE) so a
# restarted 24/7 service never waits for a manual START. scripts/run_bot.py
# defaults this to true; scripts/run_dashboard.py to false. The macOS installer
# (deploy/macos/install.sh) sets this to true for the always-on service.
# (Alias BOT_AUTOSTART is also accepted; BOT_AUTO_START wins if both are set.)
BOT_AUTO_START=false

# --- Remote dashboard auth (placeholder; required only in remote mode) ------
# Bearer token the dashboard/API requires when set. Generate your own secret
# (e.g. `openssl rand -hex 24`) — NEVER commit it. Empty => auth disabled.
DASHBOARD_TOKEN=

# --- CORS (only if a browser app on another origin must call the API) -------
# Comma-separated explicit origins. Wildcard '*' is rejected. Usually empty.
BOT_CORS_ORIGINS=

# --- Logging ----------------------------------------------------------------
# Path for a rotating log file (in addition to stdout). Empty => stdout only.
BOT_LOG_FILE=
